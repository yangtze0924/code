line level    source

   1          #include <REGX52.H>
   2          #include "Delay.h"
   3          
   4          sbit RCK=P3^5;   //RCLK
   5          sbit SCK=P3^6;   //SRCLK
   6          sbit SER=P3^4;   //SER
   7          
   8          #define MATRIX_LED_PORT   P0
   9          
  10          
  11          /**
  12             *@brief  74HC595写入一个字节
  13             *@param  Byte 要写入的字节
  14             *@retval  无
  15             */
  16          void _74HC595_WriteByte(unsigned char Byte)
  17          {
  18   1              unsigned char i;
  19   1              for(i=0;i<8;i++)
  20   1              {
  21   2                      SER=Byte&(0x80>>i);
  22   2                      SCK=1;
  23   2                      SCK=0;
  24   2              }
  25   1              RCK=1;
  26   1              RCK=0;
  27   1      }
  28          
  29          
  30          /**
  31             *@brief  点阵屏初始化
  32             *@param  无
  33             *@retval  无
  34             */
  35          void MatrixLED_Init()
  36          {
  37   1              SCK=0;
  38   1              RCK=0;  
  39   1      }
  40          /**
  41             *@brief  LED点阵屏显示一列数据
  42             *@param  Column 要选择的列，范围：0~7，0在最左边
  43             *@param  Data 选择列显示的数据，范围：0x00~0xFF，高位在上，1为亮，0为灭（因为
             -取反了）
  44             *@retval  无
  45             */
  46          void MatrixLED_ShowColumn(unsigned char Column,Data)
  47          {
  48   1              _74HC595_WriteByte(Data);
  49   1              MATRIX_LED_PORT=~(0x80>>Column);
  50   1              Delay(1);
  51   1              MATRIX_LED_PORT=0xFF;
  52   1      }

